---
import { bookingUrl } from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';

const coaching = [
  {
    name: 'Strategy Session',
    price: '$450',
    detail: 'One 90-minute working session on a single challenge, plus a written action summary. Credited toward any program within 14 days.',
  },
  {
    name: 'Focus',
    price: 'From $2,400',
    detail: '~8 weeks · 4 sessions · written 60–90-day plan · email check-ins between sessions.',
  },
  {
    name: 'Accelerate',
    price: 'From $3,600',
    detail: '3 months · 6 sessions · strengths & style assessment · executive-presence rehearsal · quick questions by text between sessions.',
    highlighted: true,
  },
  {
    name: 'Executive Partnership',
    price: 'From $7,200',
    detail: '6 months · 12 sessions · 360° stakeholder review with written report · mid-point and final reviews.',
  },
];

const rateCard = [
  ['Business consulting / change management', 'From $6,500 per engagement'],
  ['Training & workshops', 'Half-day from $2,500 · full-day from $4,500 (up to 20 people)'],
  ['Project management', 'From $4,500/mo'],
  ['Application & cloud development', 'Blueprint $1,800 (credited to the build) · builds from $8,000'],
  ['Custom software & advisory', '$175/hr in 10-hour blocks, or fixed price'],
  ['Software testing', 'Test & quality-gate audit from $3,500'],
  ['Information management', 'Assessment from $6,500'],
];

const models = [
  {
    name: 'Discovery Sprint',
    price: 'From $6,500 · fixed fee · ~2 weeks',
    tagline: 'The best first step.',
    description: 'A focused engagement to find and prioritize your highest-value AI opportunities.',
    features: ['Stakeholder interviews', 'Prioritized use-case roadmap', 'Feasibility & cost view', 'Clear recommendation'],
    highlighted: true,
  },
  {
    name: 'Project Delivery',
    price: 'From $8,000 · fixed price per phase',
    tagline: 'From prototype to production.',
    description: 'Hands-on design and delivery of a specific AI solution in your cloud.',
    features: ['Prototype / proof-of-concept', 'Production build & integration', 'Evaluation & guardrails', 'Knowledge transfer'],
    highlighted: false,
  },
  {
    name: 'Fractional AI Leadership',
    price: 'From $4,500/mo · monthly retainer',
    tagline: 'Senior guidance, on tap.',
    description: 'Ongoing strategy and technical leadership as you scale AI across the business.',
    features: ['Roadmap ownership', 'Architecture & vendor guidance', 'Team mentoring', 'Executive reporting'],
    highlighted: false,
  },
];
---

<BaseLayout
  title="Pricing"
  description="Starting prices for AITeCXO: AI discovery sprints, project delivery, fractional AI leadership, executive coaching programs, consulting, training, and development."
>
  <PageHeader
    eyebrow="Engagement models"
    title="Ways to work together"
    intro="Published prices are starting points so you can tell quickly whether we’re a fit. Every engagement is scoped to your goals, and the free first call is where we find the right size."
  />

  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="grid gap-6 lg:grid-cols-3">
      {
        models.map((m) => (
          <article
            class:list={[
              'flex h-full flex-col rounded-2xl border p-6',
              m.highlighted ? 'border-ink-900 bg-white shadow-md ring-1 ring-ink-900' : 'border-slate-200 bg-white',
            ]}
          >
            {m.highlighted && (
              <p class="mb-3 inline-flex w-fit rounded-full bg-ember-600 px-3 py-1 text-xs font-semibold text-white">
                Most popular
              </p>
            )}
            <h2 class="text-xl font-semibold text-ink-900">{m.name}</h2>
            <p class="mt-1 text-sm font-semibold text-ink-700">{m.tagline}</p>
            <p class="mt-4 text-sm font-semibold text-ink-900">{m.price}</p>
            <p class="mt-3 text-ink-500">{m.description}</p>
            <ul class="mt-4 flex-1 space-y-2">
              {m.features.map((f) => (
                <li class="flex items-start gap-3 text-sm text-ink-700">
                  <span class="diamond" aria-hidden="true" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a
              href="/contact"
              class:list={[
                'mt-6 inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors',
                m.highlighted ? 'bg-ink-900 text-white hover:bg-ink-700' : 'border border-slate-300 text-ink-700 hover:border-ink-900 hover:text-ink-900',
              ]}
            >
              Discuss this engagement
            </a>
          </article>
        ))
      }
    </div>

    <p class="mt-8 text-center text-sm text-ink-500">
      Also available: half- and full-day <strong class="font-semibold text-ink-700">workshops &amp; enablement</strong> for teams.
    </p>

    <section class="mt-20" id="coaching">
      <p class="eyebrow">Executive coaching</p>
      <h2 class="mt-3 text-3xl font-bold text-ink-900">Coaching programs</h2>
      <p class="mt-3 max-w-3xl text-ink-500">For leaders stepping into bigger roles: executive presence, organizational politics, 60-day plans, and momentum. Delivered by video; in person in Utah.</p>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {coaching.map((c) => (
          <article class:list={['flex flex-col rounded-2xl border bg-white p-6', c.highlighted ? 'border-ink-900 ring-1 ring-ink-900' : 'border-slate-200']}>
            {c.highlighted && <p class="mb-3 inline-flex w-fit rounded-full bg-ember-600 px-3 py-1 text-xs font-semibold text-white">Most popular</p>}
            <h3 class="text-lg font-semibold text-ink-900">{c.name}</h3>
            <p class="mt-1 text-xl font-bold text-ink-900">{c.price}</p>
            <p class="mt-3 flex-1 text-sm text-ink-500">{c.detail}</p>
            <a href={bookingUrl(`pricing-coaching-${c.name}`)} target="_blank" rel="noopener" class:list={['mt-5 inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-semibold transition-colors', c.highlighted ? 'bg-ink-900 text-white hover:bg-ink-700' : 'border border-slate-300 text-ink-700 hover:border-ink-900 hover:text-ink-900']}>Book a free fit call</a>
          </article>
        ))}
      </div>
      <div class="mt-6 grid gap-6 rounded-2xl border border-slate-200 bg-slate-50 p-6 text-[0.95rem] leading-relaxed text-ink-700 md:grid-cols-3">
        <p><strong class="font-semibold text-ink-900">Coaching your team?</strong> 15% off each for participants 2–3, 25% off each for participants 4–6, and a custom leadership cohort for 7 or more.</p>
        <p><strong class="font-semibold text-ink-900">Nonprofits & public education:</strong> 15% off any program. (Discounts don’t stack; you get the larger one.)</p>
        <p><strong class="font-semibold text-ink-900">Fit guarantee:</strong> if the first full session isn’t valuable, stop and receive a refund of the unused balance.</p>
      </div>
    </section>

    <section class="mt-20" id="rates">
      <p class="eyebrow">Consulting, software & data</p>
      <h2 class="mt-3 text-3xl font-bold text-ink-900">Starting rates</h2>
      <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
          <tbody class="divide-y divide-slate-200">
            {rateCard.map(([svc, price]) => (
              <tr>
                <th scope="row" class="w-1/2 px-6 py-4 font-semibold text-ink-900">{svc}</th>
                <td class="px-6 py-4 text-ink-700">{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-ink-500">Fixed-price work: 50% at signature, 50% at delivery. You own all code and deliverables on final payment. Details for each service are on the <a class="link" href="/services">services page</a>.</p>
    </section>
  </div>

  <div class="pb-16 md:pb-24">
    <CTA />
  </div>
</BaseLayout>
