---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CTA from '../../components/CTA.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Work"
  description="Selected AI engagements — outcomes from strategy, implementation, and integration projects."
>
  <PageHeader
    eyebrow="Work"
    title="Selected work"
    intro="A sample of engagements and the outcomes they delivered. Details are illustrative placeholders until client-approved case studies are published."
  />

  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    {
      entries.length === 0 ? (
        <p class="text-ink-500">Case studies are coming soon.</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2">
          {entries.map((entry) => (
            <a
              href={`/work/${entry.id}`}
              class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition-shadow hover:shadow-md"
            >
              <p class="text-sm font-medium text-brand-700">{entry.data.industry}</p>
              <h2 class="mt-1 text-xl font-semibold text-ink-900 group-hover:text-brand-700">
                {entry.data.title}
              </h2>
              <p class="mt-3 flex-1 text-ink-500">{entry.data.summary}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {entry.data.outcomes.slice(0, 3).map((o) => (
                  <li class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
                    {o}
                  </li>
                ))}
              </ul>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
                Read case study <span aria-hidden="true">&rarr;</span>
              </span>
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="pb-16 md:pb-24">
    <CTA />
  </div>
</BaseLayout>
