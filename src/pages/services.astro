---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CTA from '../components/CTA.astro';
import { SERVICES } from '../config';
---

<BaseLayout
  title="Services"
  description="AI innovation, implementation, and integration services for SMB and enterprise teams."
>
  <PageHeader
    eyebrow="Services"
    title="From AI strategy to production — and everything in between"
    intro="We offer three complementary services. Most engagements start with one and grow into the others as value is proven."
  />

  <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="space-y-16">
      {
        SERVICES.map((s, i) => (
          <section id={s.id} class="scroll-mt-24 grid gap-8 md:grid-cols-3">
            <div>
              <p class="text-sm font-bold text-accent-600">0{i + 1}</p>
              <h2 class="mt-2 text-2xl font-bold text-ink-900">{s.title}</h2>
              <p class="mt-2 font-medium text-brand-700">{s.tagline}</p>
            </div>
            <div class="md:col-span-2">
              <p class="text-lg text-ink-500">{s.description}</p>
              <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                {s.points.map((p) => (
                  <li class="flex items-start gap-2 text-ink-700">
                    <svg class="mt-1 h-5 w-5 flex-none text-accent-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 10a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                    </svg>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <div class="pb-16 md:pb-24">
    <CTA
      title="Not sure where to start?"
      text="Most teams begin with a short discovery engagement. We’ll help you find the highest-value place to start."
      buttonLabel="Book a discovery call"
    />
  </div>
</BaseLayout>
