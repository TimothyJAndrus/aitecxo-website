---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../config';

const updated = 'November 17, 2026';
---

<BaseLayout
  title="Privacy Policy"
  description="How AITeCXO handles information collected through aitecxo.com and its internal tools."
>
  <PageHeader eyebrow="Legal" title="Privacy Policy" intro={`Last updated ${updated}.`} />

  <div class="mx-auto max-w-3xl px-4 py-16 md:py-24 space-y-10 text-slate-700 leading-relaxed">
    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-slate-900">Who we are</h2>
      <p>
        {SITE.legalName} ("we", "us") is an AI consulting practice operating {SITE.domain}. Questions about this
        policy go to <a class="underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-slate-900">What this website collects</h2>
      <ul class="list-disc pl-6 space-y-2">
        <li>
          <strong>Contact form.</strong> When you send a message, we receive your name, email address, company (if
          given), and message. It is delivered to our inbox by email and used only to reply to you.
        </li>
        <li>
          <strong>Booking a call.</strong> Discovery calls are scheduled through Calendly, which handles the
          information you enter under its own privacy policy.
        </li>
        <li>
          <strong>No tracking.</strong> This site does not use advertising cookies or third-party analytics.
          Standard server and CDN logs (such as IP address and pages requested) may be kept for security and
          reliability.
        </li>
      </ul>
      <p>We do not sell or rent personal information, and we do not share it except as needed to run the services above or when required by law.</p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-slate-900">Internal tools and Google user data</h2>
      <p>
        AITeCXO operates an internal assistant application ("Hermes") that connects to Google accounts owned by
        AITeCXO's principal, using Google OAuth, to read and send email and to read and manage calendar events on
        that owner's behalf. It is not offered to the public, and it does not access any other person's Google
        account.
      </p>
      <ul class="list-disc pl-6 space-y-2">
        <li>Google user data is used only to provide the assistant's features to the account owner.</li>
        <li>Data is processed on the owner's own device; it is not sold, used for advertising, or shared with third parties.</li>
        <li>Google user data is not used to develop, improve, or train generalized AI or machine-learning models.</li>
        <li>
          Use of information received from Google APIs adheres to the
          <a class="underline" href="https://developers.google.com/terms/api-services-user-data-policy" rel="noopener noreferrer" target="_blank">Google API Services User Data Policy</a>,
          including the Limited Use requirements.
        </li>
        <li>
          Access can be revoked at any time from
          <a class="underline" href="https://myaccount.google.com/permissions" rel="noopener noreferrer" target="_blank">Google Account permissions</a>.
        </li>
      </ul>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-slate-900">Retention and your choices</h2>
      <p>
        We keep contact-form messages as long as needed to respond and maintain a business relationship. You can ask
        us to access, correct, or delete information you sent us by emailing
        <a class="underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-slate-900">Changes</h2>
      <p>We will post any changes to this policy on this page and update the date above.</p>
    </section>
  </div>
</BaseLayout>
