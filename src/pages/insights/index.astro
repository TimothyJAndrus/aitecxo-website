---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Insights"
  description="Practical perspectives on applied AI, strategy, and adoption from AITeCXO."
>
  <PageHeader
    eyebrow="Insights"
    title="Practical perspectives on applied AI"
    intro="Field notes on strategy, implementation, and integration — written for leaders who want results, not hype."
  />

  <div class="mx-auto max-w-3xl px-4 py-16 md:py-24">
    {
      posts.length === 0 ? (
        <p class="text-ink-500">New articles are on the way.</p>
      ) : (
        <ul class="space-y-10">
          {posts.map((post) => (
            <li>
              <article>
                <p class="text-sm text-ink-500">
                  <time datetime={post.data.publishDate.toISOString()}>{fmt(post.data.publishDate)}</time>
                </p>
                <h2 class="mt-1 text-2xl font-semibold text-ink-900">
                  <a class="hover:text-brand-700" href={`/insights/${post.id}`}>
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-2 text-ink-500">{post.data.description}</p>
                <a
                  href={`/insights/${post.id}`}
                  class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800"
                >
                  Read more <span aria-hidden="true">&rarr;</span>
                </a>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
