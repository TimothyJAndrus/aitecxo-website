---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTA from '../components/CTA.astro';
import { SERVICES } from '../config';
import { getCollection } from 'astro:content';

const featured = (
  await getCollection('case-studies', ({ data }) => !data.draft && data.featured)
)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);

const process = [
  { step: '01', title: 'Discover', text: 'We find where AI creates real value and prioritize by impact and feasibility.' },
  { step: '02', title: 'Prototype', text: 'We ship a thin, measurable proof-of-concept against your real data — fast.' },
  { step: '03', title: 'Productionize', text: 'We harden what works with evaluation, monitoring, and guardrails.' },
  { step: '04', title: 'Integrate & scale', text: 'We embed AI into the tools your team already uses, then expand from proof.' },
];
---

<BaseLayout>
  <Hero />

  <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">What we do</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">
        Three ways we help you win with AI
      </h2>
      <p class="mt-4 text-lg text-ink-500">
        Whether you're exploring your first use case or scaling AI across the org, we meet you where you are — and focus on outcomes you can measure.
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        SERVICES.map((s) => (
          <ServiceCard
            id={s.id}
            title={s.title}
            tagline={s.tagline}
            description={s.description}
            points={s.points}
            href={`/services#${s.id}`}
          />
        ))
      }
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">How we work</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">
          Ship narrow. Measure honestly. Expand from proof.
        </h2>
        <p class="mt-4 text-lg text-ink-500">
          A disciplined path from idea to impact — built to prove value early and keep risk low.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          process.map((p) => (
            <div class="group rounded-2xl border border-slate-200 bg-white p-6 transition-shadow hover:shadow-md">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-50 text-sm font-bold text-brand-700 ring-1 ring-inset ring-brand-100">
                {p.step}
              </div>
              <h3 class="mt-4 text-lg font-semibold text-ink-900">{p.title}</h3>
              <p class="mt-2 text-sm text-ink-500">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-wide text-brand-700">Selected work</p>
            <h2 class="mt-2 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">
              Outcomes, not experiments
            </h2>
          </div>
          <a href="/work" class="text-sm font-semibold text-brand-700 hover:text-brand-800">
            View all work &rarr;
          </a>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {featured.map((entry) => (
            <a
              href={`/work/${entry.id}`}
              class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition-shadow hover:shadow-md"
            >
              <p class="text-sm font-medium text-brand-700">{entry.data.industry}</p>
              <h3 class="mt-1 text-xl font-semibold text-ink-900 group-hover:text-brand-700">
                {entry.data.title}
              </h3>
              <p class="mt-3 text-ink-500">{entry.data.summary}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {entry.data.outcomes.slice(0, 3).map((o) => (
                  <li class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
                    {o}
                  </li>
                ))}
              </ul>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <div class="pb-16 md:pb-24">
    <CTA />
  </div>
</BaseLayout>
