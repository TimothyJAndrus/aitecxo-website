---
import { NAV, SITE } from '../config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    {/*
      Horizontal lockup, no tagline: the guidelines' choice for nav bars,
      displayed at 40 px tall (see public/brand/AITeCXO-Brand-Guidelines.pdf).
      Decorative: the link already carries the accessible name.
    */}
    <a href="/" class="flex items-center" aria-label={`${SITE.name} home`}>
      <img
        src="/brand/aitecxo-lockup-horizontal.svg"
        alt=""
        width="170"
        height="40"
        class="h-9 w-auto md:h-10"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href) ? 'text-ink-900' : 'text-ink-500 hover:text-ink-900',
            ]}
          >
            {item.label}
            {isActive(item.href) && (
              <span
                class="absolute -bottom-0.5 left-1/2 h-1.5 w-1.5 -translate-x-1/2 rotate-45 bg-ember-500"
                aria-hidden="true"
              />
            )}
          </a>
        ))
      }
      <a
        href="/contact"
        class="ml-2 rounded-lg bg-ink-900 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-ink-700"
        >Get in touch</a
      >
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="inline-flex items-center justify-center rounded-md p-2 text-ink-900 md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">Toggle navigation</span>
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3" aria-label="Mobile">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-base font-medium',
              isActive(item.href) ? 'bg-slate-50 text-ink-900' : 'text-ink-700 hover:bg-slate-50',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="mt-1 rounded-lg bg-ink-900 px-4 py-2 text-center text-base font-semibold text-white"
        >Get in touch</a
      >
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
