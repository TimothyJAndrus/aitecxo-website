---
import { bookingUrl } from '../config';

interface Props {
  title?: string;
  text?: string;
  buttonLabel?: string;
  buttonHref?: string;
}
const {
  title = 'Ready to put AI to work?',
  text = 'Book a free 30-minute discovery call and we’ll map the highest-value opportunities for your team.',
  buttonLabel = 'Book a free discovery call',
  buttonHref = bookingUrl('cta'),
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-4">
  <div class="relative overflow-hidden rounded-3xl bg-ink-900 px-6 py-12 text-center md:px-12 md:py-16">
    <img
      src="/brand/aitecxo-mark.svg"
      alt=""
      width="48"
      height="48"
      class="mx-auto mb-6 h-12 w-12 rounded-[22%] ring-1 ring-white/15"
      loading="lazy"
    />
    <h2 class="mx-auto max-w-2xl text-3xl font-bold text-white md:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg font-light text-slate-400">{text}</p>
    <a
      href={buttonHref}
      target={buttonHref.startsWith('http') ? '_blank' : undefined}
      rel={buttonHref.startsWith('http') ? 'noopener' : undefined}
      class="mt-8 inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-base font-semibold text-ink-900 shadow-sm transition-colors hover:bg-slate-100"
    >
      {buttonLabel}
    </a>
    <p class="mt-4 text-sm text-slate-400">
      or <a href="/contact" class="font-medium text-white underline decoration-ember-500 decoration-2 underline-offset-4 hover:text-slate-200">send us a message</a>
    </p>
  </div>
</section>
