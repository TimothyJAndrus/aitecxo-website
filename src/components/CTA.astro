---
interface Props {
  title?: string;
  text?: string;
  buttonLabel?: string;
  buttonHref?: string;
}
const {
  title = 'Ready to put AI to work?',
  text = 'Book a free 30-minute discovery call and we’ll map the highest-value opportunities for your team.',
  buttonLabel = 'Start a conversation',
  buttonHref = '/contact',
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-4">
  <div
    class="overflow-hidden rounded-3xl bg-linear-to-br from-brand-800 to-brand-950 px-6 py-12 text-center shadow-lg md:px-12 md:py-16"
  >
    <h2 class="mx-auto max-w-2xl text-3xl font-bold text-white md:text-4xl">{title}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-brand-100">{text}</p>
    <a
      href={buttonHref}
      class="mt-8 inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-base font-semibold text-brand-800 shadow-sm transition-colors hover:bg-brand-50"
    >
      {buttonLabel}
    </a>
  </div>
</section>
