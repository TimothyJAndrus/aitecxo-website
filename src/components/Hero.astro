---
import { SITE } from '../config';
---

<section class="relative overflow-hidden bg-slate-50">
  {/* Node-grid texture: the "AI and systems" layer of the mark, kept faint. */}
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: radial-gradient(circle at 1px 1px, rgb(18 21 28 / 0.08) 1px, transparent 0); background-size: 28px 28px; -webkit-mask-image: linear-gradient(to bottom, black, transparent 80%); mask-image: linear-gradient(to bottom, black, transparent 80%);"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 md:py-28 lg:grid-cols-[1fr_auto]">
    <div>
      <p class="eyebrow">AI consulting for SMB &amp; enterprise</p>
      <h1 class="mt-6 max-w-3xl text-4xl font-bold text-ink-900 md:text-6xl md:leading-[1.08]">
        Innovate, implement, and integrate AI <span class="font-light">— without the guesswork.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg font-light text-ink-500 md:text-xl">
        {SITE.name} helps SMB and enterprise teams turn AI from hype into measurable outcomes — from opportunity discovery and roadmaps to secure, production-ready systems running in your own cloud.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact" class="btn-primary">Book a discovery call</a>
        <a href="/services" class="btn-secondary">Explore services</a>
      </div>
    </div>
    {/*
      The brand symbol, unmodified. Leadership bar, systems line, and the
      ember point of value where they cross: the whole pitch in one shape.
    */}
    <img
      src="/brand/aitecxo-symbol-x.svg"
      alt=""
      width="320"
      height="320"
      class="hidden h-72 w-72 lg:block xl:h-80 xl:w-80"
      loading="eager"
    />
  </div>
</section>
