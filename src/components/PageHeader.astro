---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="border-b border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-4 max-w-3xl text-4xl font-bold text-ink-900 md:text-5xl">
      {title}
    </h1>
    {intro && <p class="mt-4 max-w-2xl text-lg font-light text-ink-500">{intro}</p>}
    <slot />
  </div>
</section>
