---
interface Props {
  id?: string;
  title: string;
  tagline: string;
  description: string;
  points?: readonly string[];
  href?: string;
}
const { id, title, tagline, description, points = [], href } = Astro.props;
---

<article
  id={id}
  class="flex h-full scroll-mt-24 flex-col rounded-2xl border border-slate-200 bg-white p-6 transition-colors hover:border-ink-900"
>
  <h3 class="text-xl font-bold text-ink-900">{title}</h3>
  <p class="mt-1 text-sm font-semibold text-ink-700">{tagline}</p>
  <p class="mt-3 font-light text-ink-500">{description}</p>
  {
    points.length > 0 && (
      <ul class="mt-4 space-y-2">
        {points.map((p) => (
          <li class="flex items-start gap-3 text-sm text-ink-700">
            <span class="diamond" aria-hidden="true" />
            <span>{p}</span>
          </li>
        ))}
      </ul>
    )
  }
  {
    href && (
      <a href={href} class="link mt-auto inline-flex items-center gap-1 pt-6 text-sm">
        Learn more
        <span aria-hidden="true">&rarr;</span>
      </a>
    )
  }
</article>
