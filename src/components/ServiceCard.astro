---
interface Props {
  id?: string;
  title: string;
  tagline: string;
  description: string;
  points?: readonly string[];
  href?: string;
}
const { id, title, tagline, description, points = [], href } = Astro.props;
---

<article
  id={id}
  class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md scroll-mt-24"
>
  <h3 class="text-xl font-semibold text-ink-900">{title}</h3>
  <p class="mt-1 text-sm font-medium text-brand-700">{tagline}</p>
  <p class="mt-3 text-ink-500">{description}</p>
  {
    points.length > 0 && (
      <ul class="mt-4 space-y-2">
        {points.map((p) => (
          <li class="flex items-start gap-2 text-sm text-ink-700">
            <svg class="mt-0.5 h-5 w-5 flex-none text-accent-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 10a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
            </svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    )
  }
  {
    href && (
      <a
        href={href}
        class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800"
      >
        Learn more
        <span aria-hidden="true">&rarr;</span>
      </a>
    )
  }
</article>
