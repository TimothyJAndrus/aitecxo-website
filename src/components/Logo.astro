---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 220 40"
  role="img"
  aria-label="AITeCXO"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="aitecxo-mark" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2547eb" />
      <stop offset="1" stop-color="#06b6d4" />
    </linearGradient>
  </defs>
  <rect x="0" y="4" width="32" height="32" rx="9" fill="url(#aitecxo-mark)" />
  <path
    d="M9 27 L16 13 L23 27 M12 22 L20 22"
    fill="none"
    stroke="#ffffff"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <text
    x="42"
    y="27"
    font-family="Inter, system-ui, sans-serif"
    font-size="20"
    font-weight="700"
    fill="#0b1020"
  >
    <tspan fill="#2547eb">AI</tspan><tspan>TeCXO</tspan>
  </text>
</svg>
